digraph dek {
  graph [rankdir=LR, dpi=200, bgcolor="white", nodesep=0.28, ranksep=0.50,
         fontname="Noto Sans CJK SC", pad=0.3];
  node  [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC",
         fontsize=11, color="#8a8a8a", penwidth=1.0, margin="0.13,0.09"];
  edge  [color="#8a8a8a", arrowsize=0.7, fontname="Noto Sans CJK SC", fontsize=10];

  subgraph cluster_prod {
    label=<<b>产线（PC 上，每块芯片做一遍）</b>>; fontsize=12; color="#c0c0c0"; style="rounded,dashed";
    dek    [label=<<b>1. DEK</b><br/>随机 AES-256，全芯片共用一把>, fillcolor="#fdf0d5"];
    soenc  [label=<<b>2. libdenoise.enc</b><br/>AES-GCM(DEK, so)<br/>全芯片同一份>, fillcolor="#dcf0e2"];
    chipkey[label=<<b>3. ChipKey</b><br/>SHA256(UID ‖ 盐)，每块不同>, fillcolor="#efe3f5"];
    dekenc [label=<<b>4. dek.enc</b><br/>AES-GCM(ChipKey, DEK)<br/>每块芯片一份>, fillcolor="#dcf0e2"];
  }

  subgraph cluster_dev {
    label=<<b>设备（每次启动）</b>>; fontsize=12; color="#c0c0c0"; style="rounded,dashed";
    readuid [label=<<b>5. 读 UID</b><br/>派生 ChipKey>, fillcolor="#dbe8fb"];
    unseal  [label=<<b>6. 解 dek.enc</b><br/>得到 DEK>, fillcolor="#efe3f5"];
    unso    [label=<<b>7. 解 SO</b><br/>明文只在内存>, fillcolor="#efe3f5"];
    run     [label=<<b>memfd + dlopen</b><br/>不落盘执行>, fillcolor="#ececec"];
    fail    [label=<<b>换块板就断在这</b><br/>UID 不同 → ChipKey 不同<br/>解出乱码 → GCM 校验失败>, fillcolor="#f7dcdc", color="#c97070"];
  }

  dek -> soenc [label="加密"];
  dek -> dekenc [label="被包装"];
  chipkey -> dekenc [label="加密 DEK"];
  soenc -> unso [style=dashed, label="随固件发布"];
  dekenc -> unseal [style=dashed, label="随固件发布"];
  readuid -> unseal;
  unseal -> unso;
  unso -> run;
  readuid -> fail [style=dashed, color="#c97070", fontcolor="#c97070"];
}
