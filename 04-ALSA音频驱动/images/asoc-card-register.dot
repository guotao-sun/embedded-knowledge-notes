digraph G {
  rankdir=TB;
  bgcolor="white";
  dpi=200;
  nodesep=0.4;
  ranksep=0.33;
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=16, penwidth=1.1, margin="0.24,0.13"];
  edge [color="#8a8a8a", arrowsize=0.7, penwidth=1.2];

  a [label="① Machine 驱动 probe\n调用 snd_soc_register_card(&card)", fillcolor="#efe3f5", color="#8e6bb0"];
  b [label="② snd_soc_instantiate_card()\n申请 snd_card、逐个绑定 dai_link\n（cpu_dai / codec_dai / platform 按名字查找）", fillcolor="#fdf0d5", color="#c99a3c"];
  c [shape=plaintext, label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9">
      <TR><TD COLSPAN="2" BGCOLOR="#fdf0d5"><B>③ 依次执行（顺序固定）</B></TD></TR>
      <TR><TD>card-&gt;probe()</TD><TD>Machine 自己的补充初始化</TD></TR>
      <TR><TD>cpu_dai-&gt;probe()</TD><TD>SAI 控制器：申请寄存器 / 时钟 / DMA</TD></TR>
      <TR><TD>codec-&gt;probe()</TD><TD>WM8960 上电、regmap 初始化</TD></TR>
      <TR><TD>platform-&gt;probe()</TD><TD>DMA 引擎就绪</TD></TR>
      <TR><TD>dai_link-&gt;init(codec)</TD><TD>Machine 写板级小配置（如 HP 检测）</TD></TR>
    </TABLE>>];
  d [label="④ snd_soc_dapm_new_widgets()\n按 audio-routing 把 widget 连成路径\n（此时才知道「耳机 ← HP_L」这条线怎么走）", fillcolor="#fdf0d5", color="#c99a3c"];
  e [label="⑤ snd_card_register()\n/dev/snd/pcmC0D0p、controlC0 出现\n用户态 aplay 才能 open", fillcolor="#dcf0e2", color="#4e9c6a"];

  a -> b;
  b -> c [arrowhead=none];
  c -> d;
  d -> e;
}
